

-- to create a table for admin credentials login --
CREATE TABLE login (
    id SERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    password VARCHAR(100) NOT NULL
);

-- to create a table for employee_id, first name, Middle Name, Last Name, Birthday, Department, Position --

CREATE TABLE employees (
    --id SERIAL PRIMARY KEY, --kaya nag ulit yung table nung ID number kasi redundant na to
    employee_id VARCHAR(20) UNIQUE NOT NULL,
    first_name VARCHAR(50) NOT NULL,
    middle_name VARCHAR(50),
    last_name VARCHAR(50) NOT NULL,
    birthday DATE,
	department VARCHAR(20) NOT NULL,
	position VARCHAR(50) NOT NULL
);

